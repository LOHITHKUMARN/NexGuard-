# NexGuard Environment Configuration

# Flask Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=nexguard-secure-secret-key-change-me

# Database Configuration
DATABASE_URL=sqlite:///database/nexguard.db

# Cisco SSH Automation Credentials (Used by Netmiko)
CISCO_USERNAME=admin
CISCO_PASSWORD=cisco_password
CISCO_ENABLE_SECRET=cisco_secret
CISCO_PORT=22

# Monitoring Settings
PING_INTERVAL_SECONDS=30
PING_TIMEOUT_SECONDS=2
PING_COUNT=2

